{
  "name": "@mouse/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --port 4200 --poll 1000",
    "build": "ng build",
    "typecheck": "ng build --configuration development --output-path dist/typecheck",
    "test": "ng test",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../../.prettierignore ."
  },
  "dependencies": {
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/material": "^22.1.4",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.3",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.0.0",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.0.8"
  }
}

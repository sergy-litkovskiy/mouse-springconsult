# Environment template. Copy it to .env (which is not committed) and replace the secrets:
#
#   cp .env.example .env
#   openssl rand -base64 48   # JWT_SECRET
#   openssl rand -base64 24   # POSTGRES_PASSWORD, ADMIN_BOOTSTRAP_PASSWORD
#
# Only secrets and machine-specific values belong here. Backend constants (image sizes,
# session TTL, limits, the AI model) live in apps/api/src/config.ts under version control.
# If a value is the same on every machine, it is not an env var.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=mouse
POSTGRES_PASSWORD=change-me-postgres-password

# The application database; created separately from the maintenance POSTGRES_DB.
DATABASE_URL=postgres://mouse:change-me-postgres-password@postgres:5432/mouse_trading

# ── Host ports ───────────────────────────────────────────────────────────────
# Change these when the defaults are already taken by another project. Inside the docker
# network the services always listen on 5432 / 3000 / 4200.
# POSTGRES_HOST_PORT=5432
# API_HOST_PORT=3000
# WEB_HOST_PORT=4200

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# Signing secret of the session JWT. At least 32 characters; changing it voids all sessions.
JWT_SECRET=change-me-to-at-least-32-characters-long-secret

# ── Cloudflare R2 ────────────────────────────────────────────────────────────
# Dashboard → R2 → Overview: the Account ID is shown in the right-hand panel.
R2_ACCOUNT_ID=change-me-account-id
# R2 → Manage API tokens → "Object Read & Write" scoped to the bucket below. Take the S3 pair
# the token page shows (Access Key ID and Secret Access Key — the SHA-256 of the token value),
# not the `cfut_…` token value itself: the S3 API rejects it.
R2_ACCESS_KEY_ID=change-me-access-key-id
R2_SECRET_ACCESS_KEY=change-me-secret-access-key
R2_BUCKET=mouse-images
# The bucket's PUBLIC address (the r2.dev URL or a custom domain), without the bucket name and
# without a trailing slash. Not the S3 endpoint *.r2.cloudflarestorage.com: that one accepts
# signed requests only, so every image in the browser would fail.
R2_PUBLIC_BASE_URL=https://pub-change-me.r2.dev

# ── Anthropic ────────────────────────────────────────────────────────────────
# Optional: tests and CI never set it, and the adapter only runs when something deliberately
# constructs it with a real key. Console → workspace for this app → API key of that workspace.
# Development key: a SEPARATE workspace from production, with a $10/month spend limit — that
# limit is what still stops a runaway loop. Production uses a different workspace's key.
# ANTHROPIC_API_KEY=change-me-anthropic-api-key

# ── First administrator ──────────────────────────────────────────────────────
# Used by migration 1787738400000-create-first-user.ts. The password is never stored in
# the repository — neither in plain text nor as a hash.
ADMIN_BOOTSTRAP_EMAIL=admin@mouse.springconsult.com.ua
ADMIN_BOOTSTRAP_NAME=Адміністратор
ADMIN_BOOTSTRAP_PASSWORD=change-me-admin-password

# ── Production (docker-compose.prod.yml) ─────────────────────────────────────
# APP_DOMAIN=mouse.springconsult.com.ua
# ACME_EMAIL=admin@springconsult.com.ua
# API_IMAGE=ghcr.io/<owner>/mouse-api:latest
# WEB_IMAGE=ghcr.io/<owner>/mouse-web:latest

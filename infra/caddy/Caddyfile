{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip

	# handle_path strips the prefix: /api/auth/login → /auth/login.
	# The ng serve proxy performs the same rewrite in dev (apps/web/proxy.conf.json),
	# so apiBaseUrl equals /api in both environments, the origin is one and CORS is never needed.
	handle_path /api/* {
		# Paired with config.http.imageUploadBodyLimitBytes in apps/api/src/config.ts: 10 MiB
		# (maxImageBytes) + 1 MiB for the multipart wrapper. Change both together — a proxy that
		# stops first answers with its own bare 413, and the api never says file_too_large.
		request_body {
			max_size 11MiB
		}
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format json
	}
}

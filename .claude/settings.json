{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "Bash(npm run format)",
      "Bash(npm run format:*)",
      "Bash(npm run build)",
      "Bash(npm run build:*)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npm db:*)",
      "Bash(npm deps:check)",
      "Bash(npm typecheck)",
      "Bash(npm run test:headless)",
      "Bash(npm run dev-config)",
      "Bash(npm start)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose exec:*)",
      "Bash(git commit -m ' *)",
      "Bash(git stash *)",
      "Bash(git add *)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch:*)"
    ],
    "deny": ["Bash(git push)", "Bash(git push *)", "Read(**/environment.prod.ts)"]
  },
  "enabledPlugins": {
    "mouse-trading@mouse-trading": true
  }
}
